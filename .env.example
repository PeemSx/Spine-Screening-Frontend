# FastAPI origin used by the Next.js same-origin rewrite.
# Local: http://127.0.0.1:8000
# Hosted: https://spine-screening-api.papeam.org
SPINE_API_BASE_URL=http://127.0.0.1:8000

# Optional direct browser API origin. Leave unset to use the rewrite above.
# Only set this when the API or its gateway allows the frontend origin via CORS.
# NEXT_PUBLIC_SPINE_API_BASE_URL=https://screening-api.example.org
